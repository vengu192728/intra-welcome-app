# Copy to .env.production before building (optional).
#
# Serve from site root (default):
# VITE_BASE_PATH=/
#
# Serve from a subdirectory, e.g. https://intranet.company.local/welcome/
# VITE_BASE_PATH=/welcome/

VITE_BASE_PATH=/

# Authenticator API (intra-authenticator on port 9091).
# Use the full URL when the API is on another host/port:
# VITE_AUTH_API_URL=http://your-intranet-server:9091
#
# Leave unset if nginx proxies /api to the authenticator on the same host.
VITE_AUTH_API_URL=
